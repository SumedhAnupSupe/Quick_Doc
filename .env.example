# ---- Copy to .env for local use. NEVER commit a real .env ----
ENVIRONMENT=development            # development | test | production
APP_NAME=APAAR NEXUS

# Operational database (Neon in production; use the pooled connection string)
DATABASE_URL=postgresql+psycopg://nexus:nexus_dev_pw@db:5432/apaar_nexus
# Vault catalogues: separate databases + roles (see database/init)
CENTRAL_VAULT_DATABASE_URL=postgresql+psycopg://central_vault:central_dev_pw@db:5432/apaar_central_vault
STATE_VAULT_DATABASE_URL=postgresql+psycopg://state_vault:state_dev_pw@db:5432/apaar_state_mh_vault

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-min-32-chars!!
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

CORS_ORIGINS=http://localhost:5173
STORAGE_ROOT=/app/private_storage

# Prototype-only switches. The app REFUSES TO START in production if either is true.
DEMO_MODE=true
EXPOSE_DEMO_OTP=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Local postgres container
POSTGRES_PASSWORD=postgres_dev_pw
